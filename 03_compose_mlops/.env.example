# ============================================================================
#  03_compose_mlops — пример переменных окружения
#  Скопируйте в .env:   cp .env.example .env   и при необходимости отредактируйте.
#  Файл .env читается docker compose автоматически.
# ============================================================================

# --- Airflow ---------------------------------------------------------------
# UID вашего пользователя, чтобы файлы в ./logs и ./dags не принадлежали root.
# Узнать своё значение (Linux/macOS):  id -u
# На macOS/Windows можно оставить 50000.
AIRFLOW_UID=50000

# --- MinIO (S3-совместимое хранилище артефактов MLflow) --------------------
# Это же значение используется как AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# внутри Airflow и MLflow (они ходят в MinIO по протоколу S3).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
