# Скопируйте в .env и заполните. JWT_SECRET — обязателен.

# Секрет для подписи JWT (HS256). Сгенерируйте случайную строку, например:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# Имя LLM (served-model-name в vLLM и значение в /info).
LLM_MODEL=Qwen2.5-1.5B-Instruct

# HuggingFace-токен — нужен, если модель приватная / для увеличения лимитов скачивания.
HF_TOKEN=

# Данные студента для /info. Email — ваш настоящий: от него зависит вариант.
STUDENT_NAME=Иван Иванов
STUDENT_EMAIL=student@edu.hse.ru

# CV-модель вашего варианта — узнайте командой `make variant` и впишите сюда.
# Это имя модели в Triton (model_repository/<CV_MODEL>/) и значение models.vision в /info.
CV_MODEL=

# Хост-порт gateway (base_url = http://HOST:GATEWAY_PORT).
GATEWAY_PORT=8080


# Пороги SLO (для ориентира; проверяет грейдер своими значениями).
VISION_TOP5_THRESHOLD=0.8
VISION_P95_MS=400
CHAT_TTFT_MS=2000
